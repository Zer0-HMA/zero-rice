#@ destino: ~/.config/rofi/themes/colores.rasi
/* Generado por paleta.sh — paleta: {{nombre}} */
* {
    bg:       {{fondo.a95}};
    bg-alt:   {{fondo2}};
    fg:       {{texto}};
    fg-dim:   {{tenue}};
    acento:   {{acento}};
    acento2:  {{acento2}};
    sobre:    {{sobre}};
    sombra:   {{fondo.a69}};
    degradado: linear-gradient(to bottom, {{acento}}, {{acento2}});
}
