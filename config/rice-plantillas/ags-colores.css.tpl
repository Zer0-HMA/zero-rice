#@ destino: ~/.config/ags/colores.css
#@ requiere: dir ~/.config/ags
/* Generado por paleta.sh — paleta: {{nombre}} */
@define-color fondo      {{fondo}};
@define-color fondo2     {{fondo2}};
@define-color tenue      {{tenue}};
@define-color texto      {{texto}};
@define-color acento     {{acento}};
@define-color acento2    {{acento2}};
@define-color sobre      {{sobre}};
@define-color inactivo   {{inactivo}};
@define-color medio      {{medio}};
@define-color sombra     {{sombra}};

/* colores "reales": alertas y estados */
@define-color rojo       {{rojo}};
@define-color verde      {{verde}};
@define-color amarillo   {{amarillo}};
@define-color azul       {{azul}};
@define-color magenta    {{magenta}};
@define-color cyan       {{cyan}};

/* modo root: contrasta siempre con la barra normal (blanca en tema oscuro, negra en claro) */
@define-color root_fondo {{root_fondo}};
@define-color root_texto {{root_texto}};
@define-color root_borde {{root_borde}};
